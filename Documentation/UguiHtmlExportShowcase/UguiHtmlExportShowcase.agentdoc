@schema agentdocs/v1
@id ugui-html-export-showcase
@title "uGUI HTML Export: Live Composition"
@kind exploration
@description
This document directly composes the real HTML fragment exported from DeedPlanner's `Deed Card.prefab` in its initialized no-thumbnail state. It retains the nested RectTransform structure and exposes the paper background behind “No Screenshot.” The left close button was added afterward by cloning the exported button subtree in HTML; no Unity hierarchy or asset was changed.
@end-description

@references
@reference doc=deedplanner-3/ugui-html-export-feasibility label="Exporter contract and implementation"
@end-references

@css
.composed-demo {
  width: min(100%, 560px);
  margin: 1rem auto;
}
.ugui-export {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  overflow: visible;
  isolation: isolate;
  container-type: inline-size;
  background: transparent;
}
.ugui-export, .ugui-export * { box-sizing: border-box; }
.ugui-export__rect {
  position: absolute;
  transform-origin: 0 0;
  margin: 0;
  padding: 0;
}
.ugui-export__visual {
  position: absolute;
  inset: 0;
  margin: 0;
  padding: 0;
}
.ugui-export__image {
  display: block;
  width: 100%;
  height: 100%;
  max-width: none;
}
.ugui-export__text {
  display: flex;
  overflow: hidden;
  font-family: Arial, sans-serif;
  white-space: pre-wrap;
}
.html-only-marker { filter: drop-shadow(0 0 4px #f59e0b); }
@end-css

@section format=html title="Live Composed Result"
<p><strong>Right X:</strong> exported from Unity. <strong>Left X:</strong> added only in this document's HTML.</p>
<div class="composed-demo">
  <div class="ugui-export" data-format="ugui-html-export/v2" data-source-path="/Deed Card" data-width="280" data-height="280">
    <img class="ugui-export__visual ugui-export__image" data-component="image" data-path="/Deed Card" src="assets/deed-card-8affa786ed05.png" alt="">
    <div class="ugui-export__rect" data-path="/Deed Card/Placeholder" data-x="0" data-y="0" data-width="280" data-height="200" style="left:0%;top:0%;width:100%;height:71.42857%;transform:matrix(1,0,0,1,0,0)">
      <div class="ugui-export__visual ugui-export__text" data-component="text" data-path="/Deed Card/Placeholder" style="color:#323232FF;font-size:17.14286cqw;font-weight:400;font-style:normal;text-decoration:none;justify-content:center;text-align:center;align-items:center" data-unity-font="LiberationSans SDF">No Screenshot</div>
    </div>
